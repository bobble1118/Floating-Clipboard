<Window x:Class="FloatingClipboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Clipboard" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Background="Transparent" Foreground="#F2F2F2" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13"
        MouseLeftButtonDown="OnBackgroundDown" PreviewKeyDown="OnPreviewKey">
    <Window.Resources>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="List_MouseDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="List_MouseMove"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ToolTip" Value="{Binding Tip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5578AAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Background needs some alpha: fully transparent pixels of a layered window let clicks and drops fall through -->
    <Border x:Name="Root" Background="#14181820" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10">
        <StackPanel>
            <Grid>
                <!-- Size is set in code (UpdateShelfSize): grows with the item count up to a cap -->
                <ListBox x:Name="Shelf" AllowDrop="True" HorizontalAlignment="Left"
                         DragEnter="Shelf_DragOver" DragOver="Shelf_DragOver" Drop="Shelf_Drop" MouseDoubleClick="Shelf_DoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemWidth="82" ItemHeight="78" HorizontalAlignment="Center" VerticalAlignment="Center"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="70" Height="70">
                                <StackPanel>
                                    <Image Source="{Binding Icon}" Width="36" Height="36"/>
                                    <TextBlock Text="{Binding Label}" TextAlignment="Center" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="34" FontSize="11"/>
                                </StackPanel>
                                <!-- Remove button shown on hover: removes from the shelf only, never deletes the file -->
                                <Button Content="✕" Click="Shelf_Remove" Width="18" Height="18" FontSize="10" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                            <Setter Property="Foreground" Value="#F2F2F2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="B" Background="#CC34343C" CornerRadius="9">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="B" Property="Background" Value="#E0D04848"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="⤓" FontSize="30" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=Shelf}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Clipboard history: collapsed by default, a single Alt tap while open expands it -->
            <StackPanel x:Name="HistoryPanel" Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Left">
                <Grid>
                    <TextBox x:Name="Search" Padding="6,5" Background="#10FFFFFF" BorderBrush="#22FFFFFF"
                             Foreground="#F2F2F2" CaretBrush="#F2F2F2" TextChanged="Search_TextChanged" PreviewMouseLeftButtonDown="Search_MouseDown"/>
                    <TextBlock Text="Search" Foreground="#66FFFFFF" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox x:Name="History" Height="380" Margin="0,6,0,0" PreviewMouseLeftButtonUp="History_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Image Source="{Binding Icon}" MaxWidth="40" MaxHeight="40" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
